import matplotlib.pyplot as plt

# ---------- Conversion Trend ----------
months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
conversion = [19.6, 7.5, 6.0, 6.4, 4.4, 8.3, 10.5, 8.3, 16.0, 5.0, 6.5, 7.2]

plt.figure()
plt.plot(months, conversion)
plt.title("Conversion Rate Trend")
plt.xlabel("Month")
plt.ylabel("Conversion %")
plt.xticks(rotation=45)
plt.savefig("conversion-analysis.png")
plt.close()

# ---------- Engagement ----------
views = [120, 140, 135, 130, 125, 120, 110, 100, 95, 90, 85, 80]

plt.figure()
plt.plot(months, views)
plt.title("Engagement Trend (Views)")
plt.xlabel("Month")
plt.ylabel("Views")
plt.xticks(rotation=45)
plt.savefig("engagement-analysis.png")
plt.close()

# ---------- Sentiment ----------
labels = ["Positive", "Negative", "Neutral"]
values = [275, 82, 60]

plt.figure()
plt.bar(labels, values)
plt.title("Customer Sentiment Distribution")
plt.ylabel("Count")
plt.savefig("sentiment-analysis.png")
plt.close()

print("Images generated successfully!")
